# Copy to .env and edit. .env is git-ignored: never commit real keys.

# Port the server listens on (TV, phone and laptop use http://<laptop-ip>:PORT)
PORT=3000

# Weather location (default Amsterdam). Open-Meteo needs no API key.
WEATHER_LAT=52.3676
WEATHER_LON=4.9041
WEATHER_CITY=Amsterdam
WEATHER_TIMEZONE=Europe/Amsterdam

# Optional: auto-switch to painting mode between these times (HH:MM, 24h).
# Leave empty to switch only by hand (phone page or TV remote).
PAINTING_AUTO_START=
PAINTING_AUTO_END=

# Optional: extra-dim the painting between these times (HH:MM).
NIGHT_DIM_START=23:00
NIGHT_DIM_END=07:00

# Minutes between painting changes in painting mode
PAINTING_ROTATE_MINUTES=30

# Testing only: serve weather from a JSON file instead of the internet
# WEATHER_FIXTURE=test/fixtures/weather.json

# Later phases (not used yet)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# TMDB_API_KEY=
# ANTHROPIC_API_KEY=
